//@version=6
// =============================================================
// XAU Multi-Timeframe Support & Resistance  (v2 — dengan kekuatan level)
// Plot otomatis support/resistance dari 4H, 1H, 30m, 15m, 3m
// dalam SATU indikator (hemat slot plan free TradingView).
//
// Cara pakai:
//   1. TradingView -> chart XAUUSD -> panel bawah -> tab "Pine Editor"
//   2. Hapus isi editor, paste seluruh file ini
//   3. "Save" -> kasih nama -> "Add to chart"
//   Indikator tersimpan di AKUN kamu, jadi otomatis muncul juga di app HP.
//
// Beda dengan v1:
//   - Menyimpan BANYAK pivot per timeframe, bukan cuma yang terakhir.
//     Yang digambar = level terdekat DI ATAS harga (R) dan DI BAWAH (S),
//     jadi labelnya selalu benar walau harga sudah menembus level lama.
//   - Tiap level punya skor kekuatan dari 2 hal:
//       (a) berapa kali harga membentuk swing di area yang sama
//       (b) berapa timeframe lain yang punya level di area yang sama
//     Level kuat = garis tebal & pekat. Level lemah = tipis & transparan.
// =============================================================

indicator("XAU Multi-TF S/R", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ------------------------- INPUT -----------------------------
grpTF = "Timeframe yang ditampilkan"
use4H = input.bool(true, "4 jam",    group = grpTF, inline = "a")
use1H = input.bool(true, "1 jam",    group = grpTF, inline = "a")
use30 = input.bool(true, "30 menit", group = grpTF, inline = "b")
use15 = input.bool(true, "15 menit", group = grpTF, inline = "b")
use3  = input.bool(true, "3 menit",  group = grpTF, inline = "b")

grpPiv = "Sensitivitas pivot"
pivLeft  = input.int(10, "Bar kiri",  minval = 2, maxval = 50, group = grpPiv,
     tooltip = "Makin besar = level makin sedikit tapi makin kuat")
pivRight = input.int(10, "Bar kanan", minval = 2, maxval = 50, group = grpPiv,
     tooltip = "Level baru dikonfirmasi setelah sekian bar. Makin besar = makin telat tapi makin valid")

grpStr = "Kekuatan level"
tolMult = input.float(0.10, "Toleransi zona (x ATR 4H)", minval = 0.02, step = 0.01, group = grpStr,
     tooltip = "Dua pivot yang jaraknya di bawah ini dianggap level yang SAMA. Naikkan kalau level kembar dihitung terpisah; turunkan kalau dua level yang jelas beda malah dilebur jadi satu")
maxPer  = input.int(12, "Simpan berapa level per timeframe", minval = 3, maxval = 30, group = grpStr)
kuat2   = input.int(3, "Skor minimum untuk 2 bintang", minval = 2, group = grpStr)
kuat3   = input.int(5, "Skor minimum untuk 3 bintang", minval = 3, group = grpStr)
brkBobot = input.int(1, "Pengurang skor tiap kali level tertembus", minval = 0, group = grpStr,
     tooltip = "Level yang sering dijebol itu lemah walau sering disentuh. Isi 0 kalau tidak mau tembusan mengurangi skor")

grpVis = "Tampilan"
minSkor   = input.int(3, "Skor minimum supaya level digambar", minval = 1, group = grpVis,
     tooltip = "3 = cuma ★★ dan ★★★ yang tampil (bawaan). Isi 1 kalau mau semua level kelihatan, termasuk yang masih lemah")
showLabel = input.bool(true, "Tampilkan label", group = grpVis)
filterFar = input.bool(true, "Sembunyikan level yang jauh", group = grpVis,
     tooltip = "Level di luar jarak ini dari harga sekarang tidak digambar, biar chart tidak penuh")
atrMult   = input.float(3.0, "Batas jarak (x ATR 4H)", minval = 0.5, step = 0.5, group = grpVis)
nLevel    = input.int(2, "Berapa level per timeframe (di atas & di bawah harga)", minval = 1, maxval = 3,
     group = grpVis,
     tooltip = "1 = cuma level terdekat. 2 = level berikutnya ikut digambar, berguna buat lihat target/penahan lanjutan")
labelGaya = input.string("Kata", "Gaya label", options = ["Kata", "Bintang", "Keduanya"], group = grpVis,
     tooltip = "Kata = tulisan SUPPORT KUAT / SEDANG / LEMAH. Bintang = ★. Keduanya = dua-duanya")
showInfo  = input.bool(true, "Tampilkan keterangan jendela data", group = grpVis,
     tooltip = "Kotak kecil di pojok kanan atas: sejak kapan datanya, dan berapa lilin 4H yang dipakai. Berguna untuk tahu kapan level 4H layak dipercaya")
labelOff  = input.int(10, "Jarak label ke kanan (bar)", minval = 1, group = grpVis)
labelStep = input.int(8, "Selisih posisi label antar timeframe (bar)", minval = 0, group = grpVis,
     tooltip = "Geser label ke kanan sedikit demi sedikit supaya level yang berdekatan tidak tumpang tindih. Nol = semua sejajar")

grpAlert = "Alert"
alertSkor = input.int(5, "Skor minimum supaya alert bunyi", minval = 1, group = grpAlert,
     tooltip = "5 = setara ★★★. Turunkan ke 3 kalau mau ★★ ikut membunyikan alert")
alertDist = input.float(0.5, "Bunyi kalau harga sedekat ini (x ATR 4H)", minval = 0.05, step = 0.05,
     group = grpAlert,
     tooltip = "Alert berbunyi saat harga MENDEKAT, bukan setelah menembus — supaya masih sempat dipikirkan")

grpBrk = "Sinyal break"
showBreak  = input.bool(true, "Tandai break yang terkonfirmasi", group = grpBrk,
     tooltip = "Break baru dianggap sah kalau harga BERTAHAN di seberang level, bukan sekadar lewat sekali — itu yang membedakan tembusan asli dari jebakan (false break)")
konfirBar  = input.int(3, "Berapa lilin harus bertahan di seberang", minval = 1, group = grpBrk,
     tooltip = "Makin besar = makin jarang tertipu false break, tapi sinyalnya makin telat")
brkMargin  = input.float(0.15, "Jarak minimum dari level (x ATR 4H)", minval = 0.0, step = 0.05,
     group = grpBrk,
     tooltip = "Harga harus benar-benar menjauh dari level, bukan cuma menempel di sekitarnya")
brkMinSkor = input.int(3, "Skor minimum level yang dipantau", minval = 1, group = grpBrk,
     tooltip = "Break dari level lemah tidak menarik — bawaan 3, setara level SEDANG ke atas")

grpSesi = "Sesi pasar (high / low)"
showSesi = input.bool(true, "Tampilkan high & low tiap sesi", group = grpSesi,
     tooltip = "High/low sesi dibentuk oleh jam kerja pelaku pasar, bukan oleh pola harga — sifatnya beda dari level pivot di atas")
tzSesi   = input.string("UTC", "Zona waktu jam sesi", options = ["UTC", "Asia/Jakarta"], group = grpSesi)

useSyd  = input.bool(true,  "Sydney",    group = grpSesi, inline = "syd")
sesSyd  = input.session("2100-0600", "", group = grpSesi, inline = "syd")
cSyd    = input.color(#8d6e63, "",       group = grpSesi, inline = "syd")

useTok  = input.bool(true,  "Tokyo",     group = grpSesi, inline = "tok")
sesTok  = input.session("0000-0900", "", group = grpSesi, inline = "tok")
cTok    = input.color(#ab47bc, "",       group = grpSesi, inline = "tok")

useFra  = input.bool(false, "Frankfurt", group = grpSesi, inline = "fra")
sesFra  = input.session("0700-1600", "", group = grpSesi, inline = "fra")
cFra    = input.color(#66bb6a, "",       group = grpSesi, inline = "fra")

useLon  = input.bool(true,  "London",    group = grpSesi, inline = "lon")
sesLon  = input.session("0800-1700", "", group = grpSesi, inline = "lon")
cLon    = input.color(#26a69a, "",       group = grpSesi, inline = "lon")

useNY   = input.bool(true,  "New York",  group = grpSesi, inline = "ny")
sesNY   = input.session("1300-2200", "", group = grpSesi, inline = "ny")
cNY     = input.color(#42a5f5, "",       group = grpSesi, inline = "ny")

grpCol = "Warna per timeframe"
c4H = input.color(#ef5350, "4 jam",    group = grpCol)
c1H = input.color(#ff9800, "1 jam",    group = grpCol)
c30 = input.color(#ffd54f, "30 menit", group = grpCol)
c15 = input.color(#4dd0e1, "15 menit", group = grpCol)
c3  = input.color(#9e9e9e, "3 menit",  group = grpCol)

// ------------------------- KOLAM LEVEL ------------------------
// Semua level dari semua timeframe disimpan di satu kolam bersama.
// Itu yang bikin perhitungan confluence antar-timeframe jadi gampang.
var array<float> aPrice = array.new_float()   // harga level
var array<int>   aTouch = array.new_int()     // berapa kali disentuh swing
var array<int>   aTf    = array.new_int()     // asal timeframe (0=4H .. 4=3m)
var array<int>   aBreak = array.new_int()     // berapa kali harga menembusnya
var array<int>   aSide  = array.new_int()     // posisi harga terakhir: 1 di atas, -1 di bawah
var array<int>   aPend  = array.new_int()     // break yang sedang menunggu konfirmasi (0 = tidak ada)
var array<int>   aArah  = array.new_int()     // arah break yang sedang ditunggu

// Anti-duplikat: request.security bisa mengembalikan nilai pivot yang sama
// berkali-kali selama bar timeframe itu belum berganti.
var array<float> lastH = array.new_float(5, na)
var array<float> lastL = array.new_float(5, na)

// Patokan jarak diambil dari ATR 4H, BUKAN ATR chart yang sedang dibuka.
// Kalau pakai ATR chart, setelan jarak jadi berubah arti tiap kali ganti
// timeframe chart — di 3m nilainya kekecilan, di 4H kebesaran.
atrRef = request.security(syminfo.tickerid, "240", ta.atr(14), lookahead = barmerge.lookahead_off)
tol    = atrRef * tolMult

// Masukkan satu pivot ke kolam. Kalau sudah ada level sejenis di area yang
// sama, jangan bikin garis baru — naikkan hitungan sentuhannya.
addLevel(float p, int tfIdx) =>
    if not na(p) and not na(tol) and tol > 0
        int found = -1
        if array.size(aPrice) > 0
            for i = 0 to array.size(aPrice) - 1
                if array.get(aTf, i) == tfIdx and math.abs(array.get(aPrice, i) - p) <= tol
                    found := i
                    break
        if found >= 0
            // Geser sedikit ke rata-rata supaya level "mengikuti" zona sebenarnya
            oldP = array.get(aPrice, found)
            oldT = array.get(aTouch, found)
            array.set(aPrice, found, (oldP * oldT + p) / (oldT + 1))
            array.set(aTouch, found, oldT + 1)
        else
            array.push(aPrice, p)
            array.push(aTouch, 1)
            array.push(aTf, tfIdx)
            array.push(aBreak, 0)
            array.push(aSide, close > p ? 1 : close < p ? -1 : 0)
            array.push(aPend, 0)
            array.push(aArah, 0)
            // Buang level tertua dari timeframe ini kalau sudah kebanyakan
            int cnt = 0
            for i = 0 to array.size(aPrice) - 1
                if array.get(aTf, i) == tfIdx
                    cnt += 1
            if cnt > maxPer
                for i = 0 to array.size(aPrice) - 1
                    if array.get(aTf, i) == tfIdx
                        array.remove(aPrice, i)
                        array.remove(aTouch, i)
                        array.remove(aTf, i)
                        array.remove(aBreak, i)
                        array.remove(aSide, i)
                        array.remove(aPend, i)
                        array.remove(aArah, i)
                        break

// Berapa timeframe LAIN yang punya level di area harga yang sama.
// Inilah sinyal terbaik di chart: level yang muncul di banyak timeframe.
confluence(float p) =>
    var array<bool> seen = array.new_bool(5, false)
    for i = 0 to 4
        array.set(seen, i, false)
    if array.size(aPrice) > 0
        for i = 0 to array.size(aPrice) - 1
            if math.abs(array.get(aPrice, i) - p) <= tol * 1.5
                array.set(seen, array.get(aTf, i), true)
    int n = 0
    for i = 0 to 4
        if array.get(seen, i)
            n += 1
    n  // termasuk timeframe sendiri, jadi minimal 1

// ------------------------- AMBIL PIVOT ------------------------
// lookahead_off itu wajib. Tanpa itu indikator terlihat sangat akurat
// waktu digeser ke belakang, tapi menyesatkan saat dipakai live.
piv(simple string tf) =>
    request.security(syminfo.tickerid, tf,
         [ta.pivothigh(high, pivLeft, pivRight), ta.pivotlow(low, pivLeft, pivRight)],
         lookahead = barmerge.lookahead_off)

serap(float ph, float pl, int tfIdx) =>
    prevH = array.get(lastH, tfIdx)
    prevL = array.get(lastL, tfIdx)
    // Pakai na(prevH) di depan: perbandingan langsung dengan na hasilnya
    // bukan true/false, jadi pivot pertama tiap timeframe bisa tidak pernah masuk.
    if not na(ph) and (na(prevH) or prevH != ph)
        array.set(lastH, tfIdx, ph)
        addLevel(ph, tfIdx)
    if not na(pl) and (na(prevL) or prevL != pl)
        array.set(lastL, tfIdx, pl)
        addLevel(pl, tfIdx)

[h0, l0] = piv("240")
[h1, l1] = piv("60")
[h2, l2] = piv("30")
[h3, l3] = piv("15")
[h4, l4] = piv("3")

serap(h0, l0, 0)
serap(h1, l1, 1)
serap(h2, l2, 2)
serap(h3, l3, 3)
serap(h4, l4, 4)


// ------------------------- GAMBAR -----------------------------
bintang(int skor) =>
    skor >= kuat3 ? "★★★" : skor >= kuat2 ? "★★" : "★"

// Versi kata, biar kebaca sekilas tanpa perlu menghitung bintang
katakuat(int skor) =>
    skor >= kuat3 ? "KUAT" : skor >= kuat2 ? "SEDANG" : "LEMAH"

judulLevel(bool isR, int skor, string tf) =>
    jenis = isR ? "RESISTANCE " : "SUPPORT "
    labelGaya == "Bintang" ? tf + (isR ? " R " : " S ") + bintang(skor) :
         labelGaya == "Kata" ? jenis + katakuat(skor) + "  " + tf :
         jenis + katakuat(skor) + " " + bintang(skor) + "  " + tf

// Level yang kuat digambar tebal & pekat, yang lemah tipis & transparan.
// Jadi mata langsung tertarik ke level yang memang berarti.
transp(int skor) =>
    skor >= kuat3 ? 0 : skor >= kuat2 ? 25 : 55

// Level di luar jangkauan harga sekarang tidak usah digambar
jauh(float p) =>
    na(p) or (filterFar and math.abs(close - p) > atrRef * atrMult)

namaTf(int i) =>
    i == 0 ? "4H" : i == 1 ? "1H" : i == 2 ? "30m" : i == 3 ? "15m" : "3m"

warnaTf(int i) =>
    i == 0 ? c4H : i == 1 ? c1H : i == 2 ? c30 : i == 3 ? c15 : c3

aktifTf(int i) =>
    i == 0 ? use4H : i == 1 ? use1H : i == 2 ? use30 : i == 3 ? use15 : use3

tebal(int skor, int tfIdx) =>
    baseW = tfIdx == 0 ? 3 : tfIdx <= 2 ? 2 : 1
    skor >= kuat3 ? baseW + 1 : skor >= kuat2 ? baseW : 1

// ---- Kandidat level yang akan digambar ----------------------
// Kalau beberapa timeframe menunjuk harga yang (hampir) sama, itu SATU level,
// bukan tiga. Digabung jadi satu garis dengan satu label "4H+30m", supaya
// justru saat level paling kuat chart-nya tetap terbaca.
var array<float>  gP   = array.new_float()
var array<string> gN   = array.new_string()
var array<int>    gTf  = array.new_int()
var array<int>    gT   = array.new_int()
var array<int>    gBrk = array.new_int()
var array<bool>   gIsR = array.new_bool()

var array<line>  gLine  = array.new<line>()
var array<label> gLabel = array.new<label>()

// Zona yang alert-nya sudah dibunyikan, supaya tidak berbunyi berulang
// selama harga masih menempel di level yang sama.
var float zonaAlert = na

// Skor akhir: sentuhan + dukungan antar-timeframe, dikurangi tembusan.
hitungSkor(float p, int t, int brk) =>
    t + confluence(p) - 1 - brkBobot * brk

tambahGrup(float p, int t, int brk, int tfIdx, bool isR) =>
    if not na(p)
        int found = -1
        if array.size(gP) > 0
            for i = 0 to array.size(gP) - 1
                if array.get(gIsR, i) == isR and math.abs(array.get(gP, i) - p) <= tol
                    found := i
                    break
        if found >= 0
            // Timeframe besar diproses lebih dulu, jadi nama & warna grup
            // tetap mengikuti timeframe terbesar yang ada di dalamnya.
            array.set(gN, found, array.get(gN, found) + "+" + namaTf(tfIdx))
            array.set(gT, found, math.max(array.get(gT, found), t))
            array.set(gBrk, found, math.max(array.get(gBrk, found), brk))
        else
            array.push(gP, p)
            array.push(gN, namaTf(tfIdx))
            array.push(gTf, tfIdx)
            array.push(gT, t)
            array.push(gBrk, brk)
            array.push(gIsR, isR)

// ---- Hitung berapa kali tiap level TERTEMBUS -----------------
// Level yang sering dijebol itu lemah, walau sering disentuh. Tanpa ini,
// level yang 8 kali disentuh tapi 5 kali jebol malah dapat skor tinggi.
// Yang dipakai harga PENUTUPAN, bukan sumbu — sumbu menembus itu biasa
// dan justru sering jadi tanda level bekerja.
// Break dianggap SAH kalau harga bertahan di seberang selama beberapa lilin
// DAN benar-benar menjauh. Kalau harga balik sebelum itu, hitungannya batal —
// persis pola false break yang sering muncul di emas.
bool brkNaik  = false
bool brkTurun = false
float brkP    = na
string brkNama = ""
int brkSkor   = 0

if array.size(aPrice) > 0
    for i = 0 to array.size(aPrice) - 1
        p    = array.get(aPrice, i)
        sisi = close > p ? 1 : close < p ? -1 : 0
        lama = array.get(aSide, i)

        if sisi != 0 and lama != 0 and sisi != lama
            array.set(aBreak, i, array.get(aBreak, i) + 1)
            array.set(aPend, i, 1)
            array.set(aArah, i, sisi)
        else if array.get(aPend, i) > 0
            if sisi == array.get(aArah, i)
                array.set(aPend, i, array.get(aPend, i) + 1)
                cukupJauh = math.abs(close - p) >= atrRef * brkMargin
                if array.get(aPend, i) >= konfirBar and cukupJauh
                    array.set(aPend, i, 0)
                    skorLvl = hitungSkor(p, array.get(aTouch, i), array.get(aBreak, i) - 1)
                    if skorLvl >= brkMinSkor
                        brkP    := p
                        brkNama := namaTf(array.get(aTf, i))
                        brkSkor := skorLvl
                        if sisi == 1
                            brkNaik := true
                        else
                            brkTurun := true
            else
                // Harga balik sebelum sempat terkonfirmasi = false break
                array.set(aPend, i, 0)

        if sisi != 0
            array.set(aSide, i, sisi)

if barstate.islast
    if array.size(gLine) > 0
        for i = 0 to array.size(gLine) - 1
            line.delete(array.get(gLine, i))
    if array.size(gLabel) > 0
        for i = 0 to array.size(gLabel) - 1
            label.delete(array.get(gLabel, i))
    array.clear(gLine)
    array.clear(gLabel)
    array.clear(gP)
    array.clear(gN)
    array.clear(gTf)
    array.clear(gT)
    array.clear(gBrk)
    array.clear(gIsR)

    if array.size(aPrice) > 0
        // Urutan 0..4 = dari timeframe terbesar ke terkecil.
        for tfIdx = 0 to 4
            if aktifTf(tfIdx)
                // Level terdekat di atas harga (resistance) dan di bawah (support).
                // Pivot high yang sudah ditembus ke atas otomatis jadi kandidat
                // support — itu memang perilaku S/R yang benar (level flip).
                // Ambil beberapa level terdekat di atas dan di bawah harga, bukan
                // cuma yang paling dekat. Level kedua sering justru yang paling
                // teruji — kalau cuma satu yang digambar, dia tidak pernah kelihatan.
                float batasR = close
                float batasS = close
                for n = 1 to nLevel
                    float rP = na
                    int   rT = 0
                    int   rB = 0
                    float sP = na
                    int   sT = 0
                    int   sB = 0
                    for i = 0 to array.size(aPrice) - 1
                        if array.get(aTf, i) == tfIdx
                            p = array.get(aPrice, i)
                            if p > batasR and (na(rP) or p < rP)
                                rP := p
                                rT := array.get(aTouch, i)
                                rB := array.get(aBreak, i)
                            if p < batasS and (na(sP) or p > sP)
                                sP := p
                                sT := array.get(aTouch, i)
                                sB := array.get(aBreak, i)
                    if not na(rP)
                        tambahGrup(rP, rT, rB, tfIdx, true)
                        batasR := rP
                    if not na(sP)
                        tambahGrup(sP, sT, sB, tfIdx, false)
                        batasS := sP

        if array.size(gP) > 0
            for i = 0 to array.size(gP) - 1
                p    = array.get(gP, i)
                t    = array.get(gT, i)
                brk  = array.get(gBrk, i)
                skor = hitungSkor(p, t, brk)
                // Level lemah tidak digambar sama sekali: chart yang ramai
                // bikin ragu, bukan makin yakin.
                if not jauh(p) and skor >= minSkor
                    tfi  = array.get(gTf, i)
                    isR  = array.get(gIsR, i)
                    col  = warnaTf(tfi)
                    array.push(gLine, line.new(bar_index - 1, p, bar_index, p,
                         extend = extend.right, color = color.new(col, transp(skor)),
                         width = tebal(skor, tfi),
                         style = isR ? line.style_solid : line.style_dashed))
                    if showLabel
                        array.push(gLabel, label.new(bar_index + labelOff + i * labelStep, p,
                             judulLevel(isR, skor, array.get(gN, i)) + "  "
                             + str.tostring(p, format.mintick) + "  (" + str.tostring(t) + "x"
                             + (brk > 0 ? " · jebol " + str.tostring(brk) + "x" : "") + ")",
                             style = label.style_label_left, color = color.new(col, 88),
                             textcolor = col, size = size.small))

    // ------------------------- ALERT --------------------------
    // Bunyi saat harga MENDEKATI level kuat, bukan setelah menembus —
    // waktu menembus, kesempatan mengambil keputusan sudah lewat.
    float nearP    = na
    string nearN   = ""
    bool   nearIsR = true
    int    nearSkor = 0
    if array.size(gP) > 0
        for i = 0 to array.size(gP) - 1
            p = array.get(gP, i)
            skor = hitungSkor(p, array.get(gT, i), array.get(gBrk, i))
            if skor >= alertSkor and math.abs(close - p) <= atrRef * alertDist
                if na(nearP) or math.abs(close - p) < math.abs(close - nearP)
                    nearP    := p
                    nearN    := array.get(gN, i)
                    nearIsR  := array.get(gIsR, i)
                    nearSkor := skor

    if na(nearP)
        // Harga sudah menjauh dari semua zona kuat — siap membunyikan
        // alert lagi kalau nanti mendekat, tanpa mengulang zona yang sama.
        zonaAlert := na
    else if na(zonaAlert) or math.abs(zonaAlert - nearP) > tol
        zonaAlert := nearP
        alert("XAU mendekati " + (nearIsR ? "RESISTANCE " : "SUPPORT ") + katakuat(nearSkor)
             + " (" + nearN + ") di " + str.tostring(nearP, format.mintick)
             + "  — harga sekarang " + str.tostring(close, format.mintick),
             alert.freq_once_per_bar)

// ==================== HIGH / LOW SESI PASAR ===================
// Level ini terbentuk dari jam kerja pelaku pasar, bukan dari pola harga,
// jadi dia melengkapi level pivot di atas — bukan mengulanginya.
// High/low sesi yang baru selesai sering jadi acuan sesi berikutnya.
sesiHL(simple string spec) =>
    var float h = na
    var float l = na
    var int   b = na
    dalamSesi = not na(time(timeframe.period, spec, tzSesi))
    if dalamSesi and not dalamSesi[1]
        // Sesi baru dimulai — hitung ulang dari nol
        h := high
        l := low
        b := bar_index
    else if dalamSesi
        h := math.max(h, high)
        l := math.min(l, low)
    [h, l, b]

[sydH, sydL, sydB] = sesiHL(sesSyd)
[tokH, tokL, tokB] = sesiHL(sesTok)
[fraH, fraL, fraB] = sesiHL(sesFra)
[lonH, lonL, lonB] = sesiHL(sesLon)
[nyH,  nyL,  nyB]  = sesiHL(sesNY)

gambarSesi(simple bool aktif, float h, float l, int b, simple color col, simple string nama) =>
    var line  lnH = na
    var line  lnL = na
    var label lbH = na
    var label lbL = na
    if barstate.islast
        line.delete(lnH)
        line.delete(lnL)
        label.delete(lbH)
        label.delete(lbL)
        lnH := na
        lnL := na
        lbH := na
        lbL := na
        if showSesi and aktif and not na(h) and not na(b)
            lnH := line.new(b, h, bar_index, h, extend = extend.right,
                 color = color.new(col, 25), width = 1, style = line.style_dotted)
            lnL := line.new(b, l, bar_index, l, extend = extend.right,
                 color = color.new(col, 25), width = 1, style = line.style_dotted)
            if showLabel
                lbH := label.new(bar_index + labelOff, h, nama + " H " + str.tostring(h, format.mintick),
                     style = label.style_label_left, color = color.new(col, 90),
                     textcolor = col, size = size.tiny)
                lbL := label.new(bar_index + labelOff, l, nama + " L " + str.tostring(l, format.mintick),
                     style = label.style_label_left, color = color.new(col, 90),
                     textcolor = col, size = size.tiny)

gambarSesi(useSyd, sydH, sydL, sydB, cSyd, "Sydney")
gambarSesi(useTok, tokH, tokL, tokB, cTok, "Tokyo")
gambarSesi(useFra, fraH, fraL, fraB, cFra, "Frankfurt")
gambarSesi(useLon, lonH, lonL, lonB, cLon, "London")
gambarSesi(useNY,  nyH,  nyL,  nyB,  cNY,  "NY")

// ============ KETERANGAN JENDELA DATA =========================
// Level 4H dihitung dari data 4H yang ikut termuat bersama chart. Di chart
// menitan, jumlahnya bisa sangat sedikit — dan level yang datanya tipis
// justru tampil paling berwibawa (garis merah tebal). Kotak ini membuat
// keterbatasan itu kelihatan, bukan ditebak.
bar4H = request.security(syminfo.tickerid, "240", bar_index, lookahead = barmerge.lookahead_off)

var int   bar4Awal  = na
var int   waktuAwal = na
if na(bar4Awal) and not na(bar4H)
    bar4Awal := bar4H
if na(waktuAwal)
    waktuAwal := time

jml4H = na(bar4H) or na(bar4Awal) ? 0 : bar4H - bar4Awal + 1

// Satu pivot 4H butuh (kiri + kanan + 1) lilin. Di bawah ~5 pivot, level 4H
// praktis cuma tebakan dari segelintir ayunan harga.
mutu4H = jml4H >= (pivLeft + pivRight + 1) * 8 ? "cukup" :
     jml4H >= (pivLeft + pivRight + 1) * 3 ? "tipis" : "SANGAT TIPIS"

// Jam sesi ditulis dalam zona waktu pilihan (bawaan UTC). Ditampilkan ulang
// dalam WIB supaya tidak perlu menghitung sendiri tiap kali melihat.
jamDua(int j, string m) =>
    (j < 10 ? "0" : "") + str.tostring(j) + ":" + m

jamWib(simple string spec) =>
    off = tzSesi == "UTC" ? 7 : 0
    j1  = (int(str.tonumber(str.substring(spec, 0, 2))) + off) % 24
    m1  = str.substring(spec, 2, 4)
    j2  = (int(str.tonumber(str.substring(spec, 5, 7))) + off) % 24
    m2  = str.substring(spec, 7, 9)
    jamDua(j1, m1) + "-" + jamDua(j2, m2)

sedangBuka(simple string spec) =>
    not na(time(timeframe.period, spec, tzSesi))

// Sesi bisa lebih dari satu sekaligus — jam kerjanya memang tumpang tindih,
// dan justru jam tumpang tindih itu yang biasanya paling ramai.
barisSesi(simple bool aktif, simple string spec, simple string nama) =>
    aktif and sedangBuka(spec) ? nama + "  " + jamWib(spec) + "\n" : ""

teksSesi = barisSesi(useSyd, sesSyd, "Sydney") + barisSesi(useTok, sesTok, "Tokyo")
     + barisSesi(useFra, sesFra, "Frankfurt") + barisSesi(useLon, sesLon, "London")
     + barisSesi(useNY, sesNY, "New York")

var table info = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    if showInfo
        bg = color.new(color.black, 20)
        table.cell(info, 0, 0, "Sesi sekarang", text_color = color.gray, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 1, 0, str.format_time(timenow, "HH:mm", "Asia/Jakarta") + " WIB",
             text_color = color.white, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 0, 1, "", text_size = size.tiny, bgcolor = bg)
        table.cell(info, 1, 1, teksSesi == "" ? "(tidak ada sesi utama)" : teksSesi,
             text_color = teksSesi == "" ? color.gray : color.aqua, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 0, 2, "Jendela data", text_color = color.gray, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 1, 2, "", bgcolor = bg)
        table.cell(info, 0, 3, "sejak", text_color = color.gray, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 1, 3, str.format_time(waktuAwal, "d MMM yyyy", "Asia/Jakarta"),
             text_color = color.white, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 0, 4, "lilin 4H", text_color = color.gray, text_size = size.tiny, bgcolor = bg)
        table.cell(info, 1, 4, str.tostring(jml4H) + " (" + mutu4H + ")",
             text_color = mutu4H == "cukup" ? color.lime : mutu4H == "tipis" ? color.orange : color.red,
             text_size = size.tiny, bgcolor = bg)
    else
        table.clear(info, 0, 0, 1, 5)

// ---- Tanda break yang terkonfirmasi di chart ------------------
plotshape(showBreak and brkNaik,  title = "Break naik",  style = shape.triangleup,
     location = location.belowbar, color = color.new(#26a69a, 0), size = size.small)
plotshape(showBreak and brkTurun, title = "Break turun", style = shape.triangledown,
     location = location.abovebar, color = color.new(#ef5350, 0), size = size.small)

if showBreak and (brkNaik or brkTurun)
    label.new(bar_index, brkNaik ? low : high,
         "BREAK " + (brkNaik ? "▲ " : "▼ ") + katakuat(brkSkor) + " " + brkNama + "  "
         + str.tostring(brkP, format.mintick),
         style = brkNaik ? label.style_label_up : label.style_label_down,
         color = color.new(brkNaik ? #26a69a : #ef5350, 15),
         textcolor = color.white, size = size.tiny)
    alert("XAU BREAK " + (brkNaik ? "NAIK" : "TURUN") + " menembus " + katakuat(brkSkor)
         + " (" + brkNama + ") di " + str.tostring(brkP, format.mintick)
         + " — bertahan " + str.tostring(konfirBar) + " lilin",
         alert.freq_once_per_bar)
